# ── Servidor ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Banco de dados ───────────────────────────────────────────────────────────
DB_HOST=louvor_postgres
DB_PORT=5432
DB_NAME=louvor_casaviva
DB_USER=louvor_user
DB_PASSWORD=TROQUE_POR_SENHA_FORTE

# ── JWT (obrigatório — use strings longas e aleatórias em produção) ──────────
# Gerar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=TROQUE_POR_SECRET_LONGO_E_ALEATORIO
JWT_REFRESH_SECRET=TROQUE_POR_REFRESH_SECRET_LONGO_E_ALEATORIO

# ── CORS ─────────────────────────────────────────────────────────────────────
# URL do frontend em produção (Railway, Vercel, etc.)
FRONTEND_URL=https://seu-dominio.com
# Origens adicionais separadas por vírgula (opcional)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
